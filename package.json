{
  "name": "latent-tools",
  "version": "1.1.5",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Alexander Nilsson",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer-html.js",
    "dist": "npm run build && electron-builder",
    "start": "npm run build && electron .",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.nilsson.latent.tools",
    "productName": "Latent Tools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**"
        ]
      }
    ],
    "win": {
      "icon": "assets/lt_icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "lucide": "^0.400.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
